{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "jeffrey-signdex",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-22",
  "vars": {
    "ALLOWED_ORIGINS": "https://jeffjone.github.io, https://jeffjone.dev",
    "ENVIRONMENT": "production"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "jeffrey-signdex",
