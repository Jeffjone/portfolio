{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "jeffrey-signdex",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-22",
  "vars": {
    "ALLOWED_ORIGINS": "https://jeffjone.github.io, https://jeffjone.dev",
    "ENVIRONMENT": "production",
    "ADMIN_EMAIL": "joshj.jeffrey@gmail.com",
    "REVIEW_URL": "https://jeffrey-signdex.joshj-jeffrey.workers.dev/review",
    "NOTIFICATIONS_ENABLED": "true",
    "NOTIFICATION_FROM": "SignDex <notifications@mail.jeffjone.dev>",
    "ACCESS_TEAM_DOMAIN": "https://rapid-flower-2f58.cloudflareaccess.com",
    "ACCESS_AUD": "9aa34af3b96869753bc622f20d53cee4eb705c129c68fbb21f0616219b163314",
  },
  "triggers": { "crons": ["*/5 * * * *"] },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "jeffrey-signdex",
    "database_id": "94a60517-7260-4c15-b986-c2428b2c0d1c",
    "migrations_dir": "migrations"
  }]
}
